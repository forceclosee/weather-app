{
	"format_on_save": "on",
	"code_actions_on_format": {
		"source.fixAll.biome": true
	},
	"formatter": "language_server",
	"languages": {
		"JavaScript": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TypeScript": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TSX": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSON": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSONC": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"HTML": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"CSS": {
			"language_servers": [
				"biome",
				"tailwindcss-intellisense-css",
				"!vscode-css-language-server"
			]
		},
		"Markdown": {
			"formatter": "prettier"
		}
	},
	"line_ending": "prefer_lf"
}
